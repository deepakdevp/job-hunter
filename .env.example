# Job Hunter — Environment Variables
# Copy this to .env and fill in your values

# Notion Integration Token (create at https://www.notion.so/my-integrations)
NOTION_TOKEN=secret_your_token_here

# Notion Database ID (leave blank to create one via `hunt init`)
NOTION_DATABASE_ID=

# LLM Provider: "gemini" (free) or "claude" (premium)
LLM_PROVIDER=gemini

# Gemini API Key (free at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# LLM Model
LLM_MODEL=gemini-2.0-flash

# Anthropic API Key (optional, for Claude provider)
ANTHROPIC_API_KEY=
